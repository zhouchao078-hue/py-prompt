DEEPSEEK_API_KEY=
TAVILY_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_BASE=https://api.deepseek.com
IMAGE_API_KEY=
IMAGE_API_BASE=https://your-relay.example.com/v1
IMAGE_MODEL=
# Only set this when the relay explicitly requires b64_json.
IMAGE_RESPONSE_FORMAT=
# 让中转直接返回 webp（体积约为 PNG 的 1/5），仅在上游支持 output_format 时设置
IMAGE_OUTPUT_FORMAT=
IMAGE_RETENTION_DAYS=7
IMAGE_SIZE_SQUARE=1024x1024
IMAGE_SIZE_LANDSCAPE=1536x1024
IMAGE_SIZE_PORTRAIT=1024x1536

# 数据目录。留空则使用项目根目录下的 data/。
# 容器部署时设为 /data 并挂载持久卷。
DATA_DIR=

# —— 公网部署必填 ——
# 访问口令：留空 = 不启用鉴权（仅限本机使用）
DEMO_ACCESS_CODE=
# 会话签名密钥，务必替换：openssl rand -hex 32
THREAD_SECRET=

# —— 公网配额（按需调整）——
RATE_LIMIT_PER_IP_PER_HOUR=20
DAILY_REQUEST_CAP=500
# 公网部署务必设为 true，否则任何人都能往提示词库里写内容
DEMO_READONLY_LIBRARY=false

# —— 生成并发与熔断 ——
MAX_CONCURRENT_GENERATIONS=8
MAX_GENERATION_QUEUE=16
GENERATION_DEADLINE_SECONDS=45
UPSTREAM_FAILURE_THRESHOLD=5
UPSTREAM_COOLDOWN_SECONDS=30
MAX_REQUEST_BODY_BYTES=262144

# —— 图片生成配额（成本与磁盘的大头）——
IMAGE_PER_HOUR=6
IMAGE_MAX_IN_FLIGHT=4
IMAGE_MAX_WORKERS=4

# —— 磁盘巡检与保留策略 ——
JANITOR_INTERVAL_SECONDS=3600
CACHE_RETENTION_DAYS=30
# 对话历史保留 7 天，超期由巡检清理
CONVERSATION_RETENTION_DAYS=7
MIN_FREE_DISK_GB=2
# 数据库快照：巡检每小时做一份 VACUUM INTO，保留最近 N 份（24 ≈ 一天）
BACKUP_KEEP=24

# —— 会话 ——
# 身份存在服务端，浏览器只拿这个 HttpOnly cookie；换设备靠会话码恢复
SESSION_COOKIE_DAYS=180

# —— 联网检索 ——
# on_demand：只有用户明确要查资料才联网（默认，避免 20s 慢路径）
# always / never：强制开关
WEB_RESEARCH_MODE=on_demand
WEB_RESEARCH_BUDGET_SECONDS=8
# 单次 Tavily 调用的硬超时，以及检索深度（basic 比 advanced 快很多）
TAVILY_TIMEOUT_SECONDS=12
TAVILY_SEARCH_DEPTH=basic
