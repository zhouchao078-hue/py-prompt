{"id": "c005", "bucket": "compose", "query": "一个可爱的萌娃，黑色大眼睛，面部特写", "expect": {"route": "any", "include": [["娃", "孩子", "萌娃"], ["眼睛"]], "exclude": []}, "notes": "萌娃系列在库里有命中", "holdout": true}
{"id": "c006", "bucket": "compose", "query": "白色短腿胖小猫在雪山上滑雪，真实摄影，超广角", "expect": {"route": "compose", "include": [["猫"], ["雪"], ["滑雪", "滑"]], "exclude": []}, "notes": "原评测样例，雪山命中"}
{"id": "c007", "bucket": "aspect", "query": "一只小猫，--ar 2:3", "expect": {"route": "any", "include": [["猫"]], "exclude": [], "aspect": "2:3"}, "notes": "竖版画幅必须保留"}
{"id": "c008", "bucket": "aspect", "query": "雪山风景，超广角，--ar 16:9", "expect": {"route": "any", "include": [["雪"]], "exclude": [], "aspect": "16:9"}, "notes": "横版画幅", "holdout": true}
{"id": "c009", "bucket": "aspect", "query": "萌娃特写，柔和光线，--ar 1:1", "expect": {"route": "any", "include": [["娃", "孩子"]], "exclude": [], "aspect": "1:1"}, "notes": "方形画幅"}
