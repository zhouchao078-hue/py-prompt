{"id": "c011", "bucket": "longtail", "query": "敦煌壁画风格的飞天，工笔重彩，对称构图", "expect": {"route": "any", "include": [["敦煌", "飞天"], ["工笔", "重彩"]], "exclude": []}, "notes": "库里无此主题", "holdout": true}
{"id": "c012", "bucket": "longtail", "query": "一只用发光苔藓做成的水母，漂浮在深夜的图书馆里", "expect": {"route": "any", "include": [["水母"], ["图书馆"], ["苔藓"]], "exclude": []}, "notes": "怪诞组合"}
